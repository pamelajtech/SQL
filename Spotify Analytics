-- For this project, I downloaded Spotify data from Kaggle.
-- Then I created a table to insert Spotify data into.
-- Finally, I performed analytics on the data using SQL.

-- Creating the table: 
CREATE TABLE BIT_DB.Spotifydata (
id integer PRIMARY KEY,
artist_name varchar NOT NULL,
track_name varchar NOT NULL,
track_id varchar NOT NULL,
popularity integer NOT NULL,
danceability decimal(4,3) NOT NULL,
energy decimal(4,3) NOT NULL,
key integer NOT NULL,
loudness decimal(5,3) NOT NULL,
mode integer NOT NULL,
speechiness decimal(5,4) NOT NULL,
acousticness decimal(6,5) NOT NULL,
instrumentalness text NOT NULL,
liveness decimal(5,4) NOT NULL,
valence decimal(4,3) NOT NULL,
tempo decimal(6,3) NOT NULL,
duration_ms integer NOT NULL,
time_signature integer NOT NULL 
)

-- Then I inserted the Spotify Data .csv into the table.

-- Next, I explored the data using the following SQL. 

-- First I determined the average popularity, danceability, and energy by artist and track
SELECT artist_name,
       track_name,
       AVG(popularity) AS avg_popularity,
       AVG(danceability) AS avg_danceability,
       AVG(energy) AS avg_energy
FROM BIT_DB.Spotifydata
GROUP BY artist_name, track_name;

-- Next I identified the top 10 most popular tracks to understand which songs perform best
SELECT track_name,
       artist_name,
       popularity
FROM BIT_DB.Spotifydata
ORDER BY popularity DESC
LIMIT 10;

-- Then I analyzed the average song duration in minutes to understand listening trends
SELECT AVG(duration_ms) / 60000 AS avg_duration_minutes
FROM BIT_DB.Spotifydata;

-- I examined how many songs exist per artist to see who appears most frequently in the dataset
SELECT artist_name,
       COUNT(*) AS total_tracks
FROM BIT_DB.Spotifydata
GROUP BY artist_name
ORDER BY total_tracks DESC;

-- I explored which songs have high energy and high danceability to find potential party tracks
SELECT track_name,
       artist_name,
       energy,
       danceability
FROM BIT_DB.Spotifydata
WHERE energy > 0.75
  AND danceability > 0.75
ORDER BY energy DESC;

-- Finally, I reviewed the average loudness and tempo by artist to compare overall sound characteristics
SELECT artist_name,
       AVG(loudness) AS avg_loudness,
       AVG(tempo) AS avg_tempo
FROM BIT_DB.Spotifydata
GROUP BY artist_name
ORDER BY avg_tempo DESC;
