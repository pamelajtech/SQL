-- SQL analysis project using the Chinook database to demonstrate joins, aggregations, filtering, etc.

-- 1. Identify the customer with the highest lifetime spending.
SELECT c.CustomerId,
       c.FirstName,
       c.LastName,
       ROUND(SUM(i.Total),2) AS Total_Spent
FROM chinook.Customers c
JOIN chinook.Invoices i
  ON c.CustomerId = i.CustomerId
GROUP BY c.CustomerId, c.FirstName, c.LastName
ORDER BY Total_Spent DESC
LIMIT 1;

-- 2. Determine which music genre earns the highest total sales.
SELECT g.Name AS Genre,
       ROUND(SUM(il.UnitPrice * il.Quantity),2) AS Revenue
FROM chinook.Invoice_Items il
JOIN chinook.Tracks t
  ON il.TrackId = t.TrackId
JOIN chinook.Genres g
  ON t.GenreId = g.GenreId
GROUP BY g.Name
ORDER BY Revenue DESC
LIMIT 1;

-- 3. Show the average invoice value per country, but only include countries with significant activity.
SELECT BillingCountry,
       ROUND(AVG(Total),2) AS Avg_Invoice,
       COUNT(*) AS Invoice_Count
FROM chinook.Invoices
GROUP BY BillingCountry
HAVING COUNT(*) > 5
ORDER BY Avg_Invoice DESC;

-- 4. Find the highest-earning sales employee for each year.
SELECT strftime('%Y', i.InvoiceDate) AS Year,
       e.FirstName,
       e.LastName,
       ROUND(SUM(i.Total),2) AS Total_Sales
FROM chinook.Employees e
JOIN chinook.Customers c
  ON e.EmployeeId = c.SupportRepId
JOIN chinook.Invoices i
  ON c.CustomerId = i.CustomerId
GROUP BY Year, e.EmployeeId
ORDER BY Year, Total_Sales DESC;

-- 5. Filter the customer table to view only customers located in Brazil for regional analysis.
SELECT * FROM chinook.customers 
WHERE Country = "Brazil";

-- 6. How much revenue was generated each month?
SELECT strftime('%Y-%m', InvoiceDate) AS Month,
       ROUND(SUM(Total),2) AS Monthly_Revenue
FROM chinook.Invoices
GROUP BY Month
ORDER BY Month;

-- 7. Which individual track sold the most copies?
SELECT t.Name AS Track,
       SUM(il.Quantity) AS Copies_Sold
FROM chinook.Invoice_Items il
JOIN chinook.Tracks t
  ON il.TrackId = t.TrackId
GROUP BY t.Name
ORDER BY Copies_Sold DESC
LIMIT 1;

-- 8. What is the average amount each customer spends in each country?
SELECT c.Country,
       ROUND(AVG(i.Total),2) AS Avg_Spending
FROM chinook.Customers c
JOIN chinook.Invoices i
  ON c.CustomerId = i.CustomerId
GROUP BY c.Country
ORDER BY Avg_Spending DESC;

-- 9. How many customers made more than one purchase?
SELECT COUNT(*) AS Returning_Customers
FROM (
    SELECT CustomerId
    FROM chinook.Invoices
    GROUP BY CustomerId
    HAVING COUNT(InvoiceId) > 1
);

-- 10. Which artist earned the most revenue?
SELECT ar.Name AS Artist,
       ROUND(SUM(il.UnitPrice * il.Quantity),2) AS Revenue
FROM chinook.Invoice_Items il
JOIN chinook.Tracks t ON il.TrackId = t.TrackId
JOIN chinook.Albums a ON t.AlbumId = a.AlbumId
JOIN chinook.Artists ar ON a.ArtistId = ar.ArtistId
GROUP BY ar.Name
ORDER BY Revenue DESC
LIMIT 1;

-- 11. Which tracks have the fewest purchases?
SELECT t.Name AS Track,
       SUM(il.Quantity) AS Copies_Sold
FROM chinook.Invoice_Items il
JOIN chinook.Tracks t ON il.TrackId = t.TrackId
GROUP BY t.Name
ORDER BY Copies_Sold ASC
LIMIT 5;

-- 12. Question: Is revenue increasing year over year?
SELECT strftime('%Y', InvoiceDate) AS Year,
       ROUND(SUM(Total),2) AS Yearly_Revenue
FROM chinook.Invoices
GROUP BY Year
ORDER BY Year;

-- 13. Which genres are purchased the most?
SELECT g.Name AS Genre,
       SUM(il.Quantity) AS Total_Purchases
FROM chinook.Invoice_Items il
JOIN chinook.Tracks t ON il.TrackId = t.TrackId
JOIN chinook.Genres g ON t.GenreId = g.GenreId
GROUP BY g.Name
ORDER BY Total_Purchases DESC;
